		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"cose-base": "^2.2.0",
		"cytoscape": "^3.34.0",
		"cytoscape-fcose": "^2.2.0",
		"layout-base": "^2.0.1",
		"marked": "^18.0.6"
	}
}
